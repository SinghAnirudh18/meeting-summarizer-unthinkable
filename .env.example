# ============================================================
# AI-Powered Meeting Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.

# ----- PostgreSQL -----
POSTGRES_USER=meetingplatform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=meetingplatform
DATABASE_URL=postgresql+asyncpg://meetingplatform:changeme@localhost:5432/meetingplatform

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0

# ----- Security -----
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_OF_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- LiveKit Cloud -----
# Get these from https://cloud.livekit.io
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# ----- CORS -----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ----- Frontend (Next.js public env vars) -----
# These are exposed to the browser — do NOT put secrets here
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_API_URL=http://localhost:8000

# ----- Environment -----
ENVIRONMENT=development
LOG_LEVEL=INFO

# GROQ API (Phase 2 Audio Intelligence)
GROQ_API_KEY=gsk_your_groq_api_key_here
